{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "cmake debug build",
            "command": "cmake -DCMAKE_BUILD_TYPE=Debug ..",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "options": {
                "cwd": "${workspaceFolder}/build"
            }
        },
        {
            "type": "shell",
            "label": "cmake release build",
            "command": "cmake -DCMAKE_BUILD_TYPE=Release ..",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/build"
            }
        }
    ]
}